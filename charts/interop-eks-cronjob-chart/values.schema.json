{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "cronjob": {
      "type": "object",
      "properties": {
        "image": {
          "description": "Container Image",
          "properties": {
            "repositoryPrefix": {
              "type": "string"
            },
            "imagePullPolicy": {
              "type": "string"
            }
          },
          "type": "object",
          "required": [
            "repositoryPrefix"
          ]
        },
        "resources": {
          "description": "Container Resources consumption",
          "properties": {
            "requests": {
              "properties": {
                "cpu": {
                  "type": ["string", "null"]
                },
                "memory": {
                  "type": ["string", "null"]
                }
              },
              "type": "object"
            },
            "limits": {
              "properties": {
                "cpu": {
                  "type": ["string", "null"]
                },
                "memory": {
                  "type": ["string", "null"]
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "schedule": {
          "description": "Cronjob scheduling expression",
          "type": "string"
        },
        "flywayInitContainer": {
          "description": "Optional Flyway init container configuration",
          "properties": {
            "create": {
              "description": "Enable the Flyway init container",
              "type": "boolean"
            },
            "image": {
              "description": "Flyway init container image configuration",
              "properties": {
                "repositoryPrefix": {
                  "description": "Image repository prefix; defaults to 'docker.io' (official Docker Hub namespace). Override to use a custom registry.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "repositoryName": {
                  "description": "Image repository name; defaults to 'flyway/flyway' (official Flyway image). Must be non-empty when create is true.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tag": {
                  "description": "Image tag; defaults to '8.2.3' (official Flyway release). Override to pin a different version.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "digest": {
                  "description": "Image digest; if set, overrides tag",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "imagePullPolicy": {
                  "description": "Image pull policy for the Flyway init container; if unset, the Kubernetes default applies (IfNotPresent)",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "executeFlywayMigrate": {
              "description": "Execute Flyway migrate command to apply migrations to the database",
              "type": "boolean"
            },
            "executeFlywayRepair": {
              "description": "Execute Flyway repair command to recompute applied migrations checksum metadata",
              "type": "boolean"
            },
            "downloadRedshiftDriver": {
              "description": "Enable Flyway to download the Redshift JDBC driver",
              "type": "boolean"
            },
            "migrationsConfigmap": {
              "description": "Name of the ConfigMap containing migration files, mounted at /flyway/sql; mutually exclusive with migrationPaths",
              "type": [
                "string",
                "null"
              ]
            },
            "migrationPaths": {
              "description": "Comma-separated list of paths to migration files or directories; mutually exclusive with migrationsConfigmap",
              "type": [
                "string",
                "null"
              ]
            },
            "env": {
              "description": "Environment variables specified as direct key/value pairs",
              "type": "object"
            },
            "envFromConfigmaps": {
              "description": "Environment variables sourced from external ConfigMap keys",
              "type": "object"
            },
            "envFromSecrets": {
              "description": "Environment variables sourced from external Secret keys",
              "type": "object"
            },
            "envFromFieldRef": {
              "description": "Environment variables sourced from Pod fields via the downward API",
              "type": "object"
            },
            "resources": {
              "description": "Resource requests and limits for the Flyway init container; defaults to cronjob.resources if not set",
              "properties": {
                "requests": {
                  "properties": {
                    "cpu": {
                      "type": ["string", "null"]
                    },
                    "memory": {
                      "type": ["string", "null"]
                    }
                  },
                  "type": "object"
                },
                "limits": {
                  "properties": {
                    "cpu": {
                      "type": ["string", "null"]
                    },
                    "memory": {
                      "type": ["string", "null"]
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "resources",
        "schedule"
      ]
    },
    "name": {
      "description": "Service name",
      "type": "string"
    },
    "namespace": {
      "description": "Kubernetes namespace",
      "type": "string"
    },
    "serviceAccount": {
      "description": "ServiceAccount configuration",
      "type": "object",
      "properties": {
        "roleArn": {
          "description": "Optional IAM Role ARN used for eks.amazonaws.com/role-arn annotation",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "argocd": {
      "description": "ArgoCD configuration",
      "type": "object",
      "properties": {
        "appMonitoring": {
          "description": "ArgoCD app monitoring job configuration",
          "type": "object",
          "allOf": [
            {
              "if": {
                "properties": {
                  "enable": { "const": true }
                }
              },
              "then": {
                "required": [
                  "projectRepositoryURL",
                  "jobNamespace",
                  "serviceAccountName",
                  "tfEnv",
                  "tfStateBucketKeyPrefix"
                ],
                "properties": {
                  "projectRepositoryURL": {
                    "type": "string",
                    "minLength": 1
                  },
                  "jobNamespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serviceAccountName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tfEnv": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tfStateBucketKeyPrefix": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ],
          "properties": {
            "enable": {
              "description": "Enable the management of monitoring resources using a Job with ArgoCD PostSync hook",
              "type": "boolean",
              "default": false
            },
            "projectRepositoryURL": {
              "description": "URL of the GitHub repository containing the 'terraform/k8s-monitoring-argocd-application' Terraform state",
              "type": ["string", "null"]
            },
            "projectRepositoryRef": {
              "description": "Git branch or tag to checkout",
              "type": "string",
              "default": "main"
            },
            "jobNamespace": {
              "description": "Namespace in which the Job with ArgoCD PostSync hook runs",
              "type": ["string", "null"]
            },
            "serviceAccountName": {
              "description": "Name of the ServiceAccount with the IRSA annotation granting the Job the permission to manage AWS monitoring resources",
              "type": ["string", "null"]
            },
            "workloadKind": {
              "description": "Kind of workload to monitor",
              "type": "string",
              "default": "CronJob"
            },
            "tfEnv": {
              "description": "Terraform environment to use for managing monitoring resources",
              "type": ["string", "null"]
            },
            "tfStateBucketKeyPrefix": {
              "description": "Bucket key prefix storing the Terraform state file",
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "externalSecrets": {
      "description": "External Secrets Operator configuration - separate configuration for app and Flyway init container",
      "type": "object",
      "properties": {
        "app": {
          "description": "External Secrets configuration for the main application container",
          "type": "object",
          "properties": {
            "create": {
              "description": "Enable ExternalSecret creation for app container",
              "type": "boolean",
              "default": false
            },
            "refreshInterval": {
              "description": "Refresh interval for the secret (e.g., '1h', '30m')",
              "type": "string",
              "default": "0"
            },
            "refreshPolicy": {
              "description": "Refresh policy for the secret",
              "type": "string",
              "enum": ["OnChange", "Interval"],
              "default": "OnChange"
            },
            "secretStoreRef": {
              "description": "Reference to SecretStore or ClusterSecretStore",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the SecretStore",
                  "type": "string"
                },
                "kind": {
                  "description": "Kind of the store",
                  "type": "string",
                  "enum": ["SecretStore", "ClusterSecretStore"],
                  "default": "SecretStore"
                }
              }
            },
            "targetSecret": {
              "description": "Target Kubernetes Secret configuration",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the target secret (defaults to microservice name)",
                  "type": "string"
                },
                "creationPolicy": {
                  "description": "Creation policy for the target secret",
                  "type": "string",
                  "enum": ["Owner", "Orphan", "Merge", "None"],
                  "default": "Merge"
                },
                "deletionPolicy": {
                  "description": "Deletion policy for the target secret",
                  "type": "string",
                  "enum": ["Retain", "Delete"],
                  "default": "Retain"
                }
              }
            },
            "data": {
              "description": "List of individual secret keys to sync from external secret manager for the app container",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretKey": {
                    "description": "Key name in the target Kubernetes Secret",
                    "type": "string"
                  },
                  "remoteRef": {
                    "description": "Reference to the remote secret",
                    "type": "object",
                    "properties": {
                      "key": {
                        "description": "Remote secret key/path",
                        "type": "string"
                      },
                      "property": {
                        "description": "Property to extract from the remote secret",
                        "type": "string"
                      },
                      "version": {
                        "description": "Version identifier for the remote secret",
                        "type": "string"
                      },
                      "conversionStrategy": {
                        "description": "Conversion strategy",
                        "type": "string"
                      },
                      "decodingStrategy": {
                        "description": "Decoding strategy",
                        "type": "string"
                      }
                    },
                    "required": ["key"],
                    "additionalProperties": false
                  }
                },
                "required": ["secretKey", "remoteRef"],
                "additionalProperties": false
              },
              "default": []
            }
          }
        },
        "flywayInitContainer": {
          "description": "External Secrets configuration for the Flyway init container",
          "type": "object",
          "properties": {
            "create": {
              "description": "Enable ExternalSecret creation for Flyway init container",
              "type": "boolean",
              "default": false
            },
            "refreshInterval": {
              "description": "Refresh interval for the secret (e.g., '1h', '30m')",
              "type": "string",
              "default": "0"
            },
            "refreshPolicy": {
              "description": "Refresh policy for the secret",
              "type": "string",
              "enum": ["OnChange", "Interval"],
              "default": "OnChange"
            },
            "secretStoreRef": {
              "description": "Reference to SecretStore or ClusterSecretStore",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the SecretStore",
                  "type": "string"
                },
                "kind": {
                  "description": "Kind of the store",
                  "type": "string",
                  "enum": ["SecretStore", "ClusterSecretStore"],
                  "default": "SecretStore"
                }
              }
            },
            "targetSecret": {
              "description": "Target Kubernetes Secret configuration",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the target secret (defaults to microservice name with -flyway suffix)",
                  "type": "string"
                },
                "creationPolicy": {
                  "description": "Creation policy for the target secret",
                  "type": "string",
                  "enum": ["Owner", "Orphan", "Merge", "None"],
                  "default": "Merge"
                },
                "deletionPolicy": {
                  "description": "Deletion policy for the target secret",
                  "type": "string",
                  "enum": ["Retain", "Delete"],
                  "default": "Retain"
                }
              }
            },
            "data": {
              "description": "List of individual secret keys to sync from external secret manager for the Flyway init container",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretKey": {
                    "description": "Key name in the target Kubernetes Secret",
                    "type": "string"
                  },
                  "remoteRef": {
                    "description": "Reference to the remote secret",
                    "type": "object",
                    "properties": {
                      "key": {
                        "description": "Remote secret key/path",
                        "type": "string"
                      },
                      "property": {
                        "description": "Property to extract from the remote secret",
                        "type": "string"
                      },
                      "version": {
                        "description": "Version identifier for the remote secret",
                        "type": "string"
                      },
                      "conversionStrategy": {
                        "description": "Conversion strategy",
                        "type": "string"
                      },
                      "decodingStrategy": {
                        "description": "Decoding strategy",
                        "type": "string"
                      }
                    },
                    "required": ["key"],
                    "additionalProperties": false
                  }
                },
                "required": ["secretKey", "remoteRef"],
                "additionalProperties": false
              },
              "default": []
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "namespace"
  ],
  "title": "Values",
  "type": "object"
}
